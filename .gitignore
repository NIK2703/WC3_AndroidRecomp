# wc3_android_recomp - source tree hygiene
#
# The generated lift corpus is derived from the licensed game binaries and is
# never committed.  Build products, host test binaries and tool caches are
# regenerated locally.  See docs/FILE_LAYOUT.md for the rules enforced by
# tools/check_file_layout.py.

# --- generated code and build products -------------------------------------
/build/
/out/
/gen/
/runtime/guest/generated/
/runtime/gfx/dxvk_*/build/
/apps/android_gameactivity/build/
/apps/android_gameactivity/app/build/
/apps/android_gameactivity/.gradle/
/apps/android_gameactivity/.kotlin/

# --- compiled artefacts -----------------------------------------------------
*.o
*.obj
*.a
*.so
*.exe
*.apk
*.dll
!third_party/capstone/bin/capstone.dll
# FFmpeg arm64 static archives are pinned vendor inputs, like the Media3 AARs.
!third_party/ffmpeg/lib/arm64-v8a/*.a
*.lib
*.exp
*.pdb
*.ilk
/third_party/softfloat/build-host/

# --- caches -----------------------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# --- generated reports (regenerate with the tools) --------------------------
/reports/
/reports/generated/

# --- local-only documentation and assistant state --------------------------
/docs/
/AGENTS.md
/.workbuddy-ai/
/.wokbuddy/

# --- game assets must never be committed -----------------------------------
*.mpq
*.mix
*.wav
*.mp3
*.blp
*.mdx
*.mdl
*.w3m
*.w3x
*.w3g

# --- runtime logs, screenshots and device dumps ----------------------------
# Produced by local runs and adb captures; keep them out of the tree.  The
# pre-commit hook (tools/check_no_junk.py) rejects them even when force-added.
*.log
*.raw
*.dmp
/core.[0-9]*
/vgcore.[0-9]*
/device_logcat*.txt
/game_mode*.txt
/grid_*.png
/logcat*.txt
/run*.txt
/screen*.png
/sel[0-9]*_trace*.txt
/sf[0-9]*.txt
/thr[0-9]*.bin
/wc3_log*.txt

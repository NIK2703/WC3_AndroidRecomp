<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launch"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <!-- Left ledger leaf: mode identity and current readiness. -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Wc3Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/launch_eyebrow" />

                <ImageView
                    android:id="@+id/mode_icon"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_medallion"
                    android:contentDescription="@string/launch_mode_tft"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher_tft" />

                <TextView
                    android:id="@+id/mode_title"
                    style="@style/Wc3ModeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:maxLines="3"
                    android:text="@string/launch_mode_tft" />

                <TextView
                    style="@style/Wc3Version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/launch_version" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/launch_line" />

                <TextView
                    style="@style/Wc3Helper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/launch_shortcut_hint" />
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@color/launch_line" />

        <TextView
            style="@style/Wc3Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launch_section_status" />

        <TextView
            android:id="@+id/mode_state"
            style="@style/Wc3Helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="@string/launch_status_unset" />
    </LinearLayout>

    <!-- Right ledger leaf: editable launch parameters. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Wc3Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launch_title" />

        <TextView
            style="@style/Wc3Helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/launch_subtitle" />

        <LinearLayout
            android:id="@+id/error_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_error_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/error_text"
                style="@style/Wc3ErrorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite" />

            <Button
                android:id="@+id/grant_button"
                style="@style/Wc3ButtonGhost"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:minHeight="40dp"
                android:minWidth="0dp"
                android:text="@string/launch_grant"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 01: game folder. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Wc3RowNumber"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/launch_row_01" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Wc3RowLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/launch_folder_label" />

                        <TextView
                            style="@style/Wc3Helper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/launch_folder_help" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/folder_input"
                        style="@style/Wc3Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/launch_folder_hint"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:maxLength="1000"
                        android:saveEnabled="false" />

                    <Button
                        android:id="@+id/find_folder_button"
                        style="@style/Wc3ButtonGhost"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:text="@string/launch_folder_find" />
                </LinearLayout>

                <TextView
                    android:id="@+id/folder_status"
                    style="@style/Wc3Helper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/launch_status_unset" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/launch_line" />

                <!-- 02: guest backbuffer resolution. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Wc3RowNumber"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/launch_row_02" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Wc3RowLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/launch_resolution_label" />

                        <TextView
                            style="@style/Wc3Helper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/launch_resolution_help" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/width_input"
                        style="@style/Wc3Field"
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:hint="@string/launch_width_hint"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="4"
                        android:saveEnabled="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="serif"
                        android:text="@string/launch_resolution_separator"
                        android:textColor="@color/launch_muted"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/height_input"
                        style="@style/Wc3Field"
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:hint="@string/launch_height_hint"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="4"
                        android:saveEnabled="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/preset_native"
                        style="@style/Wc3Chip"
                        android:text="@string/launch_preset_native" />

                    <TextView
                        android:id="@+id/preset_720"
                        style="@style/Wc3Chip"
                        android:text="@string/launch_preset_720" />

                    <TextView
                        android:id="@+id/preset_900"
                        style="@style/Wc3Chip"
                        android:text="@string/launch_preset_900" />

                    <TextView
                        android:id="@+id/preset_1080"
                        style="@style/Wc3Chip"
                        android:text="@string/launch_preset_1080" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/launch_line" />

                <!-- 03: sound.  The switch maps to -nosound, not a debug env. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Wc3RowNumber"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/launch_row_03" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Wc3RowLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/launch_sound_label" />

                        <TextView
                            style="@style/Wc3Helper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/launch_sound_help" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sound_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/launch_sound_label"
                        android:saveEnabled="false"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/launch_line" />

                <!-- 04: extra guest arguments. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Wc3RowNumber"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/launch_row_04" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Wc3RowLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/launch_args_label" />

                        <TextView
                            style="@style/Wc3Helper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/launch_args_help" />
                    </LinearLayout>
                </LinearLayout>

                <EditText
                    android:id="@+id/args_input"
                    style="@style/Wc3Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/launch_args_hint"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:maxLength="200"
                    android:saveEnabled="false" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/launch_line" />

                <TextView
                    style="@style/Wc3Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/launch_section_advanced" />

                <!-- 05: experimental AAudio latency. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Wc3RowNumber"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/launch_row_05" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Wc3RowLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/launch_latency_label" />

                        <TextView
                            style="@style/Wc3Helper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/launch_latency_help" />
                    </LinearLayout>
                </LinearLayout>

                <EditText
                    android:id="@+id/latency_input"
                    style="@style/Wc3Field"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:hint="@string/launch_latency_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:saveEnabled="false" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <Button
                android:id="@+id/reset_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/launch_reset"
                android:textAllCaps="false"
                android:textColor="@color/launch_muted"
                android:textSize="12sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/done_button"
                style="@style/Wc3ButtonGhost"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/launch_done" />

            <Button
                android:id="@+id/play_button"
                style="@style/Wc3ButtonPrimary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="8dp"
                android:drawableTint="@color/button_primary_text"
                android:enabled="false"
                android:text="@string/launch_play" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

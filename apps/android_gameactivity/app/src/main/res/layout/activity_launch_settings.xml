<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launch"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <TextView
        style="@style/Wc3Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/launch_title" />

    <TextView
        style="@style/Wc3Helper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/launch_subtitle" />

    <LinearLayout
        android:id="@+id/error_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_error_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_text"
            style="@style/Wc3ErrorText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/grant_button"
            style="@style/Wc3ButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/launch_grant"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                style="@style/Wc3RowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launch_folder_label" />

            <TextView
                style="@style/Wc3Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/launch_folder_help" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/folder_input"
                    style="@style/Wc3Field"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/launch_folder_hint"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:maxLength="1000"
                    android:saveEnabled="false" />

                <Button
                    android:id="@+id/choose_folder_button"
                    style="@style/Wc3ButtonGhost"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/launch_folder_choose" />

                <Button
                    android:id="@+id/find_folder_button"
                    style="@style/Wc3ButtonGhost"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/launch_folder_find" />
            </LinearLayout>

            <TextView
                android:id="@+id/folder_status"
                style="@style/Wc3Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite" />

            <TextView
                style="@style/Wc3RowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/launch_resolution_label" />

            <TextView
                style="@style/Wc3Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/launch_resolution_help" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp">

                <Spinner
                    android:id="@+id/resolution_spinner"
                    style="@style/Wc3Spinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:saveEnabled="false" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_expand_more"
                    android:tint="@color/launch_gold_light" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Wc3RowLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/launch_sound_label" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sound_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/launch_sound_label"
                    android:saveEnabled="false"
                    app:thumbTint="@color/switch_thumb"
                    app:trackTint="@color/switch_track" />
            </LinearLayout>

            <TextView
                style="@style/Wc3RowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/launch_args_label" />

            <EditText
                android:id="@+id/args_input"
                style="@style/Wc3Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/launch_args_hint"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLength="200"
                android:saveEnabled="false" />

            <TextView
                style="@style/Wc3RowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/launch_latency_label" />

            <TextView
                style="@style/Wc3Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/launch_latency_help" />

            <EditText
                android:id="@+id/latency_input"
                style="@style/Wc3Field"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:hint="@string/launch_latency_hint"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:saveEnabled="false" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/reset_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/launch_reset"
            android:textAllCaps="false"
            android:textColor="@color/launch_muted"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/done_button"
            style="@style/Wc3ButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/launch_done" />

        <Button
            android:id="@+id/play_button"
            style="@style/Wc3ButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="8dp"
            android:drawableTint="@color/button_primary_text"
            android:enabled="false"
            android:text="@string/launch_play" />
    </LinearLayout>
</LinearLayout>

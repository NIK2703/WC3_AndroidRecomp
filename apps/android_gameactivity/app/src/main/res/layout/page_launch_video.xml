<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Wc3RowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launch_resolution_label" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp">

            <Spinner
                android:id="@+id/resolution_spinner"
                style="@style/Wc3Spinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:saveEnabled="false" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more"
                android:tint="@color/launch_gold_light" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/grid_options_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Wc3RowLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/launch_grid_darken_label" />

                <TextView
                    android:id="@+id/grid_darken_value"
                    style="@style/Wc3RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:minWidth="72dp"
                    android:textColor="@color/launch_gold_light" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/grid_darken_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/launch_grid_darken_label"
                android:max="100"
                android:saveEnabled="false"
                android:progressBackgroundTint="@color/launch_muted"
                android:progressTint="@color/launch_gold"
                android:thumbTint="@color/launch_gold_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Wc3RowLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/launch_grid_cycle_label" />

                <TextView
                    android:id="@+id/grid_cycle_value"
                    style="@style/Wc3RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:minWidth="72dp"
                    android:textColor="@color/launch_gold_light" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/grid_cycle_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/launch_grid_cycle_label"
                android:max="60"
                android:saveEnabled="false"
                android:progressBackgroundTint="@color/launch_muted"
                android:progressTint="@color/launch_gold"
                android:thumbTint="@color/launch_gold_light" />
        </LinearLayout>

        <TextView
            style="@style/Wc3RowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/launch_present_mode_label" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp">

            <Spinner
                android:id="@+id/present_mode_spinner"
                style="@style/Wc3Spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/launch_present_mode_label"
                android:minHeight="48dp"
                android:saveEnabled="false" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more"
                android:tint="@color/launch_gold_light" />
        </FrameLayout>

        <TextView
            style="@style/Wc3RowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/launch_present_buffers_label" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp">

            <Spinner
                android:id="@+id/present_buffers_spinner"
                style="@style/Wc3Spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/launch_present_buffers_label"
                android:minHeight="48dp"
                android:saveEnabled="false" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more"
                android:tint="@color/launch_gold_light" />
        </FrameLayout>

        <TextView
            android:id="@+id/driver_label"
            style="@style/Wc3RowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/launch_driver_label" />

        <FrameLayout
            android:id="@+id/driver_picker_frame"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp">

            <Spinner
                android:id="@+id/driver_spinner"
                style="@style/Wc3Spinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:saveEnabled="false" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more"
                android:tint="@color/launch_gold_light" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/driver_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/driver_import_button"
                style="@style/Wc3ButtonGhost"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/launch_driver_import" />

            <Button
                android:id="@+id/driver_remove_button"
                style="@style/Wc3ButtonGhost"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/launch_driver_remove" />
        </LinearLayout>

        <TextView
            style="@style/Wc3RowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/launch_dxvk_label" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp">

            <Spinner
                android:id="@+id/dxvk_spinner"
                style="@style/Wc3Spinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:saveEnabled="false" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more"
                android:tint="@color/launch_gold_light" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Wc3RowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/launch_dxvk_config_label" />

            <Button
                android:id="@+id/dxvk_config_import"
                style="@style/Wc3ButtonGhost"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/launch_dxvk_config_import_description"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/launch_dxvk_config_import" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Wc3Helper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:text="@string/launch_dxvk_config_key" />

            <TextView
                style="@style/Wc3Helper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:text="@string/launch_dxvk_config_value" />

            <View
                android:layout_width="44dp"
                android:layout_height="1dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dxvk_config_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/dxvk_config_add"
            style="@style/Wc3ButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:minHeight="44dp"
            android:minWidth="0dp"
            android:text="@string/launch_dxvk_config_add" />
    </LinearLayout>
</ScrollView>

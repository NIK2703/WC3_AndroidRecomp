<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GameActivity extends AppCompatActivity, so the host theme must be an
         AppCompat theme.  Keep the window chrome out of the game surface and
         use a black background before the first frame. -->
    <style name="Wc3Theme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The host starts from a black window; a blank splash keeps the cold
         start free of an icon intro before GameActivity's first frame. -->
    <style name="Wc3Theme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <!-- API 31+ draws a splash window.  Keep it in the same warm-black palette
         instead of the default application icon flash. -->
    <style name="Wc3LaunchTheme" parent="Wc3LaunchTheme.Base">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launch_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_panel</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>

    <!-- A launcher gate must never draw a splash window; the only visible
         transition is the game host itself. -->
    <style name="Wc3GateTheme" parent="Wc3GateTheme.Base">
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>

From: WC3 Android recomp
Subject: [PATCH] memory: place host-visible maps below 4 GB for the 32-bit guest

The recomposed Warcraft III guest is 32-bit, so it can only dereference
addresses below 4 GB.  DXVK normally maps host-visible memory wherever the
driver chooses, which forces the thin D3D9 bridge to keep a low shadow copy
of every locked vertex/index buffer and memcpy on Lock/Unlock.

This is the 1.10.3 version of the same optimization as
dxvk-3.1.1-lowmem-placed.patch.  1.10.3 bundles Vulkan 1.3.217 headers, so
the KHR_map_memory2 and EXT_map_memory_placed definitions live in
shim/wc3_vulkan_lowmem.h instead of the vendored header set.  Feature and
property queries are chained manually in dxvk_adapter.cpp because 1.10.3
predates the table-driven device-info code.

When the physical device exposes VK_EXT_map_memory_placed, ask the driver to
place host-visible mappings in the window that the WC3 Win32 shim reserves
for them.  VK_KHR_map_memory2 is enabled as well, and the placed feature is
chained only when both device extensions are enabled.  The shim probes a free
gap with MAP_FIXED_NOREPLACE, unmaps it, and returns the address; the
allocator calls vkMapMemory2KHR with VK_MEMORY_MAP_PLACED_BIT_EXT.  Any
refusal falls back to the ordinary vkMapMemory path, so a driver without the
extension (or a fragmented low window) keeps the shadow behavior.

1.10.3 already picks a 64 MB host-visible chunk on a 64-bit host, which fits
the measured low holes; no extra cap is needed.  The feature is controlled by
dxvk.lowMemoryPlaced (default true).

This is WC3-specific rather than an upstream-compatible default: the low
window and the 4 GB assumption come from runtime/guest layouts.

diff --git a/src/dxvk/dxvk_memory.cpp b/src/dxvk/dxvk_memory.cpp
--- a/src/dxvk/dxvk_memory.cpp
+++ b/src/dxvk/dxvk_memory.cpp
@@ -2,6 +2,9 @@
 
 #include "dxvk_device.h"
 #include "dxvk_memory.h"
+
+/* The shim owns the low address-space window; DXVK only asks for a hole. */
+#include "wc3_lowmem.h"
 
 namespace dxvk {
   
@@ -232,6 +235,24 @@
         }
       }
     }
+
+    /* The 32-bit guest can only dereference a pointer below 4 GB.  When the
+     * driver supports placed mappings, ask it to put host-visible memory in
+     * the window the shim reserves for that; the thin D3D9 bridge then hands
+     * the mapping to the guest directly and no staging copy is needed. */
+    const auto& features = m_device->features();
+
+    m_usePlacedMemory = m_device->config().lowMemoryPlaced
+                     && m_device->extensions().khrMapMemory2
+                     && m_device->extensions().extMapMemoryPlaced
+                     && features.extMapMemoryPlaced.memoryMapPlaced
+                     && m_vkd->vkMapMemory2KHR != nullptr;
+
+    if (m_usePlacedMemory) {
+      m_placedAlignment = m_device->properties().extMapMemoryPlaced.minPlacedMemoryMapAlignment;
+      if (!m_placedAlignment)
+        m_placedAlignment = 4096u;
+    }
   }
   
   
@@ -428,9 +449,39 @@
       return DxvkDeviceMemory();
     
     if (flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) {
-      VkResult status = m_vkd->vkMapMemory(m_vkd->device(), result.memHandle, 0, VK_WHOLE_SIZE, 0, &result.memPointer);
-
-      if (status != VK_SUCCESS) {
+      VkResult status = VK_SUCCESS;
+
+      /* A placed mapping below 4 GB is what makes the direct guest pointer
+       * possible.  Driver or platform refusal is expected on some devices
+       * and is not an error: the ordinary mapping below keeps working. */
+      if (m_usePlacedMemory) {
+        uintptr_t address = wc3_lowmem_acquire(size, m_placedAlignment);
+
+        if (address) {
+          VkMemoryMapPlacedInfoEXT placed = { VK_STRUCTURE_TYPE_MEMORY_MAP_PLACED_INFO_EXT };
+          placed.pPlacedAddress = reinterpret_cast<void*>(address);
+
+          VkMemoryMapInfoKHR info = { VK_STRUCTURE_TYPE_MEMORY_MAP_INFO_KHR };
+          info.flags = VK_MEMORY_MAP_PLACED_BIT_EXT;
+          info.memory = result.memHandle;
+          info.offset = 0u;
+          info.size = size;
+          info.pNext = &placed;
+
+          status = m_vkd->vkMapMemory2KHR(m_vkd->device(), &info, &result.memPointer);
+
+          if (status != VK_SUCCESS) {
+            result.memPointer = nullptr;
+            Logger::debug(str::format("DxvkMemoryAllocator: Placed mapping failed with ", status));
+          }
+        }
+      }
+
+      if (!result.memPointer) {
+        status = m_vkd->vkMapMemory(m_vkd->device(), result.memHandle, 0, VK_WHOLE_SIZE, 0, &result.memPointer);
+      }
+
+      if (status != VK_SUCCESS || !result.memPointer) {
         Logger::err(str::format("DxvkMemoryAllocator: Mapping memory failed with ", status));
         m_vkd->vkFreeMemory(m_vkd->device(), result.memHandle, nullptr);
         return DxvkDeviceMemory();

diff --git a/src/dxvk/dxvk_memory.h b/src/dxvk/dxvk_memory.h
--- a/src/dxvk/dxvk_memory.h
+++ b/src/dxvk/dxvk_memory.h
@@ -393,6 +393,11 @@
     void freeEmptyChunks(
       const DxvkMemoryHeap*       heap);
 
+    /* Placed low mappings: enabled only when the driver exposes
+     * VK_EXT_map_memory_placed and the shim can find a hole below 4 GB. */
+    bool                m_usePlacedMemory = false;
+    VkDeviceSize        m_placedAlignment = 0u;
+
   };
   
 }


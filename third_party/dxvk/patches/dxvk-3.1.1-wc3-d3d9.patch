     auto vk = instance.vki();
@@ -786,6 +788,27 @@
     for (const auto& f : getFeatureList()) {
       if (f.featureRequired && !(*f.featureEnabled)) {
+        /* A forced 3.1.1 run must not abort just because an extension is
+         * missing.  Extension-provided requirements are logged and left
+         * disabled, so the code that already guards on the feature takes its
+         * fallback path.  Core Vulkan features and the swapchain cannot be
+         * emulated: without them there is no working device or presentation
+         * surface, so those stay fatal. */
+        bool isSwapchain = f.extensionEnabled
+          && !std::strcmp(f.extensionEnabled->extensionName, VK_KHR_SWAPCHAIN_EXTENSION_NAME);
+
+        if (m_ignoreMissingExtensions && f.extensionEnabled && !isSwapchain) {
+          std::string ignored = str::format("Ignoring missing required extension feature '", f.readableName, "'");
+          ignored += str::format(" (extension: ", f.extensionEnabled->extensionName, ")");
+          Logger::warn(ignored);
+          continue;
+        }
+
         std::string message = str::format("Device does not support required feature '", f.readableName, "'");

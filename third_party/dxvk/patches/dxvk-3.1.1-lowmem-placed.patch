     std::array<uint32_t, 16> m_memTypesByPropertyFlags = { };
 
+    /// Maps host-visible memory below 4 GB when the driver supports it
+    bool                m_usePlacedMemory = false;
+    VkDeviceSize        m_placedAlignment = 0u;
+
     DxvkResourceAllocationPool  m_allocationPool;
 
     uint64_t            m_nextCookie = 0u;


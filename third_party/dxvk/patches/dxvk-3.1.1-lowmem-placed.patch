From: WC3 Android recomp
Subject: [PATCH] memory: place host-visible maps below 4 GB for the 32-bit guest

The recomposed Warcraft III guest is 32-bit, so it can only dereference
addresses below 4 GB.  DXVK normally maps host-visible memory wherever the
driver chooses, which forces the thin D3D9 bridge to keep a low shadow copy
of every locked vertex/index buffer and memcpy on Lock/Unlock.

When the physical device exposes VK_KHR_map_memory2 and
VK_EXT_map_memory_placed, ask the driver to place host-visible mappings in the
window that the WC3 Win32 shim reserves for them.  The shim probes a free gap
with MAP_FIXED_NOREPLACE, unmaps it, and returns the address; the allocator
calls vkMapMemory2KHR with VK_MEMORY_MAP_PLACED_BIT_EXT.  Any refusal falls
back to the ordinary vkMapMemory path, so a driver without the extension (or
a fragmented low window) keeps the shadow behavior.

Chunk sizes for the mapped pool are capped at 64 MB while the feature is on
so the mappings fit between the Android runtime's own low mappings.  The
feature is controlled by dxvk.lowMemoryPlaced (default true) and only exists
in the 3.1.1 tree; 1.10.3 is the fallback for old Turnip drivers and keeps
the shadow path.

This is WC3-specific rather than an upstream-compatible default: the low
window and the 4 GB assumption come from runtime/guest layouts.

diff --git a/src/dxvk/dxvk_memory.cpp b/src/dxvk/dxvk_memory.cpp
--- a/src/dxvk/dxvk_memory.cpp
+++ b/src/dxvk/dxvk_memory.cpp
@@ -10,6 +10,8 @@
 #include "dxvk_device.h"
 #include "dxvk_memory.h"
 #include "dxvk_sparse.h"
+
+#include "wc3_lowmem.h"
 
 namespace dxvk {
 
@@ -790,6 +792,34 @@
       m_sparseMemoryTypes = determineSparseMemoryTypes(device);
 
     determineBufferUsageFlagsPerMemoryType();
+
+    // The 32-bit guest can only dereference a pointer below 4 GB.  When the
+    // driver supports placed mappings, ask it to put host-visible memory in
+    // the window the shim reserves for that; the thin D3D9 bridge then hands
+    // the mapping to the guest directly and no staging copy is needed.
+    const auto& features = m_device->features();
+
+    m_usePlacedMemory = m_device->config().lowMemoryPlaced
+                     && features.extMapMemoryPlaced.memoryMapPlaced
+                     && features.khrMapMemory2
+                     && m_device->vkd()->vkMapMemory2KHR != nullptr;
+
+    if (m_usePlacedMemory) {
+      m_placedAlignment = m_device->properties().extMapMemoryPlaced.minPlacedMemoryMapAlignment;
+      if (!m_placedAlignment)
+        m_placedAlignment = 4096u;
+
+      /* A 256 MB chunk usually has no free hole in the low window once the
+       * Android runtime has mapped its own spaces.  Smaller chunks still
+       * amortize the Vulkan allocation and fit the gaps the shim finds. */
+      constexpr VkDeviceSize MaxPlacedChunkSize = 64ull << 20u;
+
+      for (uint32_t i = 0; i < m_memTypeCount; i++) {
+        auto& pool = m_memTypes[i].mappedPool;
+        pool.maxChunkSize = std::min(pool.maxChunkSize, MaxPlacedChunkSize);
+        pool.nextChunkSize = std::min(pool.nextChunkSize, pool.maxChunkSize);
+      }
+    }
 
     updateMemoryHeapBudgets();
 
@@ -1920,8 +1950,39 @@
 
       auto vk = m_device->vkd();
 
-      VkResult vr = vk->vkMapMemory(vk->device(),
-        memory.memory, 0, memory.size, 0, &memory.mapPtr);
+      VkResult vr = VK_SUCCESS;
+
+      /* A placed mapping below 4 GB is what makes the direct guest pointer
+       * possible.  Driver or platform refusal is expected on some devices
+       * and is not an error: the ordinary mapping below keeps working. */
+      if (m_usePlacedMemory) {
+        uintptr_t address = wc3_lowmem_acquire(memory.size, m_placedAlignment);
+
+        if (address) {
+          VkMemoryMapPlacedInfoEXT placed = { VK_STRUCTURE_TYPE_MEMORY_MAP_PLACED_INFO_EXT };
+          placed.pPlacedAddress = reinterpret_cast<void*>(address);
+
+          VkMemoryMapInfoKHR info = { VK_STRUCTURE_TYPE_MEMORY_MAP_INFO_KHR };
+          info.flags = VK_MEMORY_MAP_PLACED_BIT_EXT;
+          info.memory = memory.memory;
+          info.offset = 0u;
+          info.size = memory.size;
+          info.pNext = &placed;
+
+          vr = vk->vkMapMemory2KHR(vk->device(), &info, &memory.mapPtr);
+
+          if (vr != VK_SUCCESS) {
+            memory.mapPtr = nullptr;
+            Logger::debug(str::format("Failed to place memory below 4 GB at 0x",
+              std::hex, address, ": ", vr));
+          }
+        }
+      }
+
+      if (!memory.mapPtr) {
+        vr = vk->vkMapMemory(vk->device(),
+          memory.memory, 0, memory.size, 0, &memory.mapPtr);
+      }
 
       if (vr != VK_SUCCESS) {
         throw DxvkError(str::format("Failed to map Vulkan memory: ", vr,


     HANDLE_EXT(extSampleLocations);                \
@@ -649,6 +652,11 @@
       m_featuresSupported.amdBufferMarker = VK_FALSE;
       m_featuresSupported.nvDeviceDiagnosticCheckpoints = VK_FALSE;
     }
+
+    // VK_EXT_map_memory_placed is defined on top of VK_KHR_map_memory2;
+    // never enable it if the command it is used with is unavailable.
+    if (!m_featuresSupported.khrMapMemory2)
+      m_featuresSupported.extMapMemoryPlaced.memoryMapPlaced = VK_FALSE;
   }
 
 
@@ -997,6 +1011,10 @@
       ENABLE_EXT(extMemoryBudget, false),
       ENABLE_EXT_FEATURE(extMemoryPriority, memoryPriority, false),
 
+      /* Placed host-visible mappings below 4 GB for the 32-bit guest */
+      ENABLE_EXT(khrMapMemory2, false),
+      ENABLE_EXT_FEATURE(extMapMemoryPlaced, memoryMapPlaced, false),
+
       /* Optionally used to batch consecutive draws */
       ENABLE_EXT_FEATURE(extMultiDraw, multiDraw, false),
 


+  VkResult Win32WsiDriver::createSurface(
+          HWND,
+          PFN_vkGetInstanceProcAddr pfnVkGetInstanceProcAddr,
+          VkInstance          instance,
+          VkSurfaceKHR*       pSurface) {
+    ANativeWindow* window = wc3_android_window();
+    if (!window)
+      return VK_ERROR_SURFACE_LOST_KHR;
+
+    auto pfnVkCreateAndroidSurfaceKHR =
+      reinterpret_cast<PFN_vkCreateAndroidSurfaceKHR>(
+        pfnVkGetInstanceProcAddr(instance, "vkCreateAndroidSurfaceKHR"));
+    if (!pfnVkCreateAndroidSurfaceKHR)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+    VkAndroidSurfaceCreateInfoKHR info = { };
+    info.sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+    info.window = window;
+    return pfnVkCreateAndroidSurfaceKHR(instance, &info, nullptr, pSurface);
+  }

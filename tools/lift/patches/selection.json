{
  "schema": 2,
  "id": "selection",
  "rev": 50,
  "description": "12/24/40 selection profile over the full relifted corpus; the engine's --verify-coverage union check is the single site-count authority.",
  "engine": "selection",
  "kind": "transform",
  "mode": "per_chunk",
  "scope": "all",
  "order": 40,
  "after": [
    "xmm_local",
    "xmm_lane",
    "w3l_compat"
  ],
  "command": {
    "args": [
      "--lift",
      "{in}",
      "--out",
      "{out}",
      "--json",
      "{report}",
      "--quiet"
    ]
  },
  "assertions": [
    {
      "kind": "report_pass"
    }
  ],
  "coverage": {
    "args": [
      "--verify-coverage"
    ],
    "reports": "manifest"
  }
}

{
  "schema": 2,
  "id": "leaf_call",
  "rev": 2,
  "description": "Whole-corpus batch transform; consumes the current work tree as an input list.",
  "engine": "leaf_call",
  "kind": "transform",
  "mode": "batch",
  "scope": "all",
  "order": 50,
  "after": [
    "selection"
  ],
  "output_layout": "flat",
  "params": {
    "gs_cookie": "0"
  },
  "command": {
    "args": [
      "--inputs",
      "{inputs}",
      "--out-dir",
      "{out_dir}",
      "--report",
      "{report}",
      "--quiet",
      "--gs-cookie={gs_cookie}"
    ]
  },
  "assertions": [
    {
      "kind": "field_equals",
      "path": "verdict",
      "equals": "pass"
    },
    {
      "kind": "field_equals",
      "path": "inputs",
      "equals_chunk_count": true
    },
    {
      "kind": "field_equals",
      "path": "unsafe_callers",
      "equals": 0
    },
    {
      "kind": "field_equals",
      "path": "gs_cookie_enabled",
      "equals_param": "gs_cookie"
    }
  ]
}
